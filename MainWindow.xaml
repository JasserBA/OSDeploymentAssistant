<Window x:Class="OSDeploymentAssistant.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OS Asset Deployment Tool"
        Width="620"
        SizeToContent="Height"
        MinHeight="640"
        MaxHeight="920"
        Background="#0A0E14"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">

    <Window.Resources>

        <!-- ===================== PALETTE ===================== -->
        <SolidColorBrush x:Key="BgBase" Color="#0A0E14"/>
        <SolidColorBrush x:Key="BgSurface" Color="#12161F"/>
        <SolidColorBrush x:Key="BgSurfaceAlt" Color="#1A2029"/>
        <SolidColorBrush x:Key="BorderLine" Color="#232A36"/>
        <SolidColorBrush x:Key="BorderLineSoft" Color="#1C222D"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#E6EDF3"/>
        <SolidColorBrush x:Key="TextMuted" Color="#7D8590"/>
        <SolidColorBrush x:Key="TextFaint" Color="#4B5563"/>
        <SolidColorBrush x:Key="AccentCyan" Color="#2DD4BF"/>
        <SolidColorBrush x:Key="AccentCyanDim" Color="#1B4B45"/>
        <SolidColorBrush x:Key="AccentCyanBright" Color="#5EEAD4"/>
        <SolidColorBrush x:Key="AccentAmber" Color="#F5A623"/>
        <SolidColorBrush x:Key="AccentSuccess" Color="#3FB950"/>
        <SolidColorBrush x:Key="AccentDanger" Color="#F85149"/>
        <SolidColorBrush x:Key="Mono" Color="#0D1117"/>

        <!-- ===================== TYPOGRAPHY HELPERS ===================== -->
        <Style x:Key="EyebrowText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource AccentCyan}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>

        <!-- ===================== CARD ===================== -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18,16"/>
        </Style>

        <!-- ===================== TEXTBOX ===================== -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource BgSurfaceAlt}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentCyan}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          Focusable="false"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#39424F"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentCyan}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#0F1219"/>
                                <Setter Property="Foreground" Value="{StaticResource TextFaint}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== COMBOBOXITEM ===================== -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Margin="4,1">
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E2733"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentCyanDim}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentCyanBright}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== COMBOBOX ===================== -->
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource BgSurfaceAlt}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Border x:Name="templateRoot"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ContentPresenter x:Name="contentPresenter"
                                                  Grid.Column="0"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  Margin="{TemplateBinding Padding}"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  IsHitTestVisible="false"/>

                                <Grid Grid.Column="1" Width="20" Height="20" Margin="0,0,10,0">
                                    <Path Width="9" Height="5" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Fill="{StaticResource TextMuted}" Stretch="Fill"
                                          Data="M 0,0 L 5,5 L 10,0 Z"/>
                                </Grid>

                                <ToggleButton x:Name="toggleButton"
                                              Grid.ColumnSpan="2"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <Popup x:Name="PART_Popup"
                                       AllowsTransparency="true"
                                       Grid.ColumnSpan="2"
                                       IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                       PopupAnimation="{DynamicResource {x:Static SystemParameters.ComboBoxPopupAnimationKey}}"
                                       Placement="Bottom">
                                    <Border x:Name="dropDownBorder"
                                            Background="{StaticResource BgSurfaceAlt}"
                                            BorderBrush="{StaticResource BorderLine}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Margin="0,4,0,0"
                                            MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                            MinWidth="{TemplateBinding ActualWidth}">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="18" Color="Black" Opacity="0.45" ShadowDepth="6"/>
                                        </Border.Effect>
                                        <ScrollViewer>
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"
                                                            Margin="0,4"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="templateRoot" Property="BorderBrush" Value="#39424F"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="templateRoot" Property="BorderBrush" Value="{StaticResource AccentCyan}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="templateRoot" Property="Background" Value="#0F1219"/>
                                <Setter Property="Foreground" Value="{StaticResource TextFaint}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== CHECKBOX (pill toggle look) ===================== -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="box" Width="34" Height="20" CornerRadius="10"
                                    Background="{StaticResource BgSurfaceAlt}"
                                    BorderBrush="{StaticResource BorderLine}" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Border x:Name="knob" Width="14" Height="14" CornerRadius="7"
                                        Background="{StaticResource TextMuted}"
                                        HorizontalAlignment="Left" Margin="2,0,0,0"/>
                            </Border>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{StaticResource AccentCyanDim}"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AccentCyan}"/>
                                <Setter TargetName="knob" Property="Background" Value="{StaticResource AccentCyanBright}"/>
                                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="knob" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="#39424F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== RADIOBUTTON (card selector look) ===================== -->
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="dot" Width="16" Height="16" CornerRadius="8"
                                    Background="{StaticResource BgSurfaceAlt}"
                                    BorderBrush="{StaticResource BorderLine}" BorderThickness="1.5"
                                    VerticalAlignment="Center">
                                <Ellipse x:Name="inner" Width="7" Height="7" Fill="{StaticResource AccentCyan}"
                                         Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="dot" Property="BorderBrush" Value="{StaticResource AccentCyan}"/>
                                <Setter TargetName="inner" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== PRIMARY BUTTON (cyan) ===================== -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Foreground" Value="#04211D"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="10" Background="{StaticResource AccentCyan}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{StaticResource AccentCyanBright}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#14B8A6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="Background" Value="#1C222D"/>
                                <Setter Property="Foreground" Value="{StaticResource TextFaint}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== SECONDARY / GHOST BUTTON ===================== -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="8" Background="{StaticResource BgSurfaceAlt}"
                                BorderBrush="{StaticResource BorderLine}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="BorderBrush" Value="{StaticResource AccentCyan}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="Background" Value="#0F1219"/>
                                <Setter Property="Foreground" Value="{StaticResource TextFaint}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== TABCONTROL / TABITEM (pill style) ===================== -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="tabBorder" CornerRadius="8" Margin="0,0,6,0" Padding="16,9"
                                Background="Transparent">
                            <ContentPresenter x:Name="content" ContentSource="Header"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="{StaticResource BgSurface}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentCyanBright}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="12.5" FontWeight="SemiBold"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="{StaticResource BgBase}" Padding="4" CornerRadius="10"
                                    BorderBrush="{StaticResource BorderLineSoft}" BorderThickness="1" Margin="0,0,0,14">
                                <TabPanel IsItemsHost="True" HorizontalAlignment="Left"/>
                            </Border>
                            <Border Grid.Row="1">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Background="{StaticResource BgBase}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top accent hairline -->
        <Border Grid.Row="0" Height="3">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#0A0E14" Offset="0.0"/>
                    <GradientStop Color="#2DD4BF" Offset="0.5"/>
                    <GradientStop Color="#0A0E14" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="18,16,18,10">

            <!-- ============ TAB 1: CONFIGURATION FORM ============ -->
            <TabItem Header="Deploy">
                <StackPanel>

                    <StackPanel Margin="2,0,2,16">
                        <TextBlock Text="ASSET DEPLOYMENT" Style="{StaticResource EyebrowText}"/>
                        <TextBlock Text="Provision hardware &amp; sync ServiceNow" FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                    </StackPanel>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="INFRASTRUCTURE NODE" Style="{StaticResource FormLabel}"/>
                                    <ComboBox x:Name="ComboNode" SelectionChanged="OnNodeSelectionChanged">
                                        <ComboBoxItem Content="LTN" IsSelected="True"/>
                                        <ComboBoxItem Content="TN4"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="TARGET OPERATING SYSTEM" Style="{StaticResource FormLabel}"/>
                                    <ComboBox x:Name="ComboOS" SelectionChanged="OnOSSelectionChanged">
                                        <ComboBoxItem Content="Windows 10 Enterprise LTSC" IsSelected="True"/>
                                        <ComboBoxItem Content="Windows 11 Enterprise LTSC (New HP G9)"/>
                                        <ComboBoxItem Content="Windows 11 23H2 Enterprise"/>
                                        <ComboBoxItem Content="Windows 11 24H2 Enterprise"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel x:Name="PanelDeviceType" Grid.Column="0">
                                    <TextBlock Text="DEVICE PROFILE" Style="{StaticResource FormLabel}"/>
                                    <ComboBox x:Name="ComboType" SelectionChanged="UpdateFormState"/>
                                </StackPanel>
                                <StackPanel x:Name="PanelSuffix" Grid.Column="2">
                                    <Grid Margin="0,0,0,7">
                                        <TextBlock Text="ASSET SUFFIX" Style="{StaticResource FormLabel}" Margin="0" HorizontalAlignment="Left"/>
                                        <TextBlock x:Name="SuffixCharCounter" Text="0 / 11" FontSize="10" Foreground="{StaticResource TextFaint}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <TextBox x:Name="TxtSuffix" TextChanged="UpdateSuffixTextChanged" FontFamily="Cascadia Code, Consolas, Segoe UI"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel x:Name="PanelUser" Visibility="Collapsed" Margin="0,0,0,14">
                                <TextBlock Text="ASSIGNED TARGET USER" Style="{StaticResource FormLabel}"/>
                                <TextBox x:Name="TxtUser" IsEnabled="False"/>
                            </StackPanel>
                            <StackPanel x:Name="PanelRollout" Visibility="Collapsed" Margin="0,0,0,14">
                                <TextBlock Text="ROLLOUT PIPELINE" Style="{StaticResource FormLabel}"/>
                                <ComboBox x:Name="ComboRollout">
                                    <ComboBoxItem Content="Standard" IsSelected="True"/>
                                    <ComboBoxItem Content="Pilot"/>
                                    <ComboBoxItem Content="Critical"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel x:Name="PanelPatch" Visibility="Visible" Margin="0,0,0,4">
                                <TextBlock Text="PATCHING CYCLE" Style="{StaticResource FormLabel}"/>
                                <ComboBox x:Name="ComboPatch">
                                    <ComboBoxItem Content="Group A - Production Weekend" IsSelected="True"/>
                                    <ComboBoxItem Content="Group B - Maintenance Window"/>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="HARDWARE MAC ADDRESSES · one per line" Style="{StaticResource FormLabel}"/>
                            <TextBox x:Name="TxtMac" TextChanged="TxtMac_TextChanged"
                                     Height="84" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top" Padding="12,10"
                                     FontFamily="Cascadia Code, Consolas, Segoe UI"/>
                        </StackPanel>
                    </Border>

                    <!-- Signature terminal-style preview -->
                    <Border CornerRadius="14" Padding="18,16" Margin="0,0,0,16" BorderThickness="1"
                            BorderBrush="{StaticResource AccentCyanDim}" Background="{StaticResource Mono}">
                        <StackPanel>
                            <TextBlock Text="TARGET ASSET NAME · calculated" Style="{StaticResource EyebrowText}" Foreground="{StaticResource TextMuted}"/>
                            <TextBlock FontFamily="Cascadia Code, Consolas" FontSize="22" FontWeight="Bold" Margin="0,4,0,0">
                                <Run Text="&gt; " Foreground="{StaticResource AccentCyanDim}"/>
                                <Run Text="{Binding Text, ElementName=TxtPreview, Mode=OneWay}" Foreground="{StaticResource AccentCyanBright}"/>
                            </TextBlock>
                            <TextBox x:Name="TxtPreview" Text="MDLTN■■■" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <Button Content="Create SCCM Asset + ServiceNow Ticket"
                            Click="CreateServiceNowTicketClick"
                            Style="{StaticResource PrimaryButton}"
                            ToolTip="Creates a new asset in SCCM and generates a ServiceNow RITM ticket"/>
                </StackPanel>
            </TabItem>

            <!-- ============ TAB 2: AUTOMATION ============ -->
            <TabItem Header="Automation">
                <StackPanel>

                    <StackPanel Margin="2,0,2,16">
                        <TextBlock Text="POST-INSTALL" Style="{StaticResource EyebrowText}"/>
                        <TextBlock Text="Automation engine" FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="Apply configs locally or remotely via SCCM/AD" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,3,0,0"/>
                    </StackPanel>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="EXECUTION TARGET" Style="{StaticResource EyebrowText}" Margin="0,0,0,12"/>

                            <RadioButton x:Name="RdoLocal" Content="Local machine (run on this PC)" GroupName="ExecutionTarget"
                                         IsChecked="True" Margin="0,0,0,12" Cursor="Hand" Checked="RdoLocal_Checked"/>

                            <RadioButton x:Name="RdoRemote" Content="Remote PC via SCCM/AD" GroupName="ExecutionTarget"
                                         Margin="0,0,0,10" Cursor="Hand" Checked="RdoRemote_Checked"/>

                            <StackPanel x:Name="PanelRemote" IsEnabled="False" Margin="26,4,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="TARGET COMPUTER NAME" Style="{StaticResource FormLabel}"/>
                                        <TextBox x:Name="TxtRemotePC" Text="" IsEnabled="False"
                                                 KeyDown="TxtRemotePC_KeyDown" FontFamily="Cascadia Code, Consolas, Segoe UI"/>
                                    </StackPanel>

                                    <Button x:Name="BtnPing" Grid.Column="1" Content="Ping"
                                            Width="76" Margin="10,20,0,0"
                                            Style="{StaticResource GhostButton}"
                                            IsEnabled="False"
                                            Click="BtnPing_Click"/>
                                </Grid>

                                <Border x:Name="PingStatus" CornerRadius="8" Padding="10,7" Margin="0,10,0,0"
                                        Background="{StaticResource BgSurfaceAlt}" BorderThickness="1" BorderBrush="{StaticResource BorderLine}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="PingIndicator" Width="8" Height="8" Fill="{StaticResource TextFaint}" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="PingStatusText" Text="Not tested" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock FontSize="10.5" Foreground="{StaticResource TextFaint}" Margin="0,8,0,0" TextWrapping="Wrap">
                                    Enter the computer name as registered in AD/SCCM, then ping to test connectivity
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="AUTOMATION OPTIONS" Style="{StaticResource EyebrowText}" Margin="0,0,0,12"/>

                            <CheckBox x:Name="ChkFirewall" Content="Open ICMPv4 (allow ping)" IsChecked="True" Margin="0,0,0,12" Cursor="Hand"/>
                            <CheckBox x:Name="ChkTimezone" Content="Set timezone: W. Central Africa Standard Time" IsChecked="True" Margin="0,0,0,12" Cursor="Hand"/>
                            <CheckBox x:Name="ChkKeyboard" Content="Set keyboard layout: French (fr-FR)" IsChecked="True" Margin="0,0,0,12" Cursor="Hand"/>
                            <CheckBox x:Name="ChkRegistryFix" Content="Apply Windows Update registry fix" IsChecked="False" Margin="0,0,0,12" Cursor="Hand"/>

                            <Border Height="1" Background="{StaticResource BorderLineSoft}" Margin="0,2,0,14"/>

                            <CheckBox x:Name="ChkSCCM" Content="Trigger SCCM client policy retrieval &amp; evaluation" IsChecked="False" Margin="0,0,0,12" Cursor="Hand"/>
                            <CheckBox x:Name="ChkAD" Content="Update AD computer object description" IsChecked="False" Cursor="Hand"/>
                        </StackPanel>
                    </Border>

                    <Button x:Name="BtnExecute" Content="Execute post-installation automation"
                            Click="RunAutomationClick" Style="{StaticResource PrimaryButton}" Margin="0,0,0,12"/>

                    <Border CornerRadius="9" Padding="14,11" BorderThickness="1" BorderBrush="{StaticResource BorderLineSoft}" Background="{StaticResource BgSurface}">
                        <TextBox x:Name="TxtAutomationStatus" Text="Ready. Select target and options, then execute."
                                 FontSize="11.5" Foreground="{StaticResource TextMuted}" Background="Transparent"
                                 BorderThickness="0" IsReadOnly="True" TextWrapping="Wrap" IsEnabled="True"/>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- ============ TAB 3: LIVE TRACKING MONITOR ============ -->
            <TabItem Header="Tickets">
                <StackPanel>
                    <StackPanel Margin="2,0,2,16">
                        <TextBlock Text="LIVE MONITORING" Style="{StaticResource EyebrowText}"/>
                        <TextBlock Text="Active pipeline board" FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="Automatic lifecycle cleanup after 45 minutes" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,3,0,0"/>
                    </StackPanel>

                    <Border CornerRadius="14" BorderThickness="1" BorderBrush="{StaticResource BorderLine}"
                            Background="{StaticResource BgSurface}" ClipToBounds="True">
                        <ListView x:Name="ListTickets" BorderThickness="0" Background="Transparent"
                                  Foreground="{StaticResource TextPrimary}" AlternationCount="2">
                            <ListView.Resources>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="6,13"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderLineSoft}"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#151B26"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                                <Style TargetType="GridViewColumnHeader">
                                    <Setter Property="Background" Value="{StaticResource BgSurfaceAlt}"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                    <Setter Property="FontSize" Value="10.5"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Padding" Value="12,10"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderLine}"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                </Style>
                            </ListView.Resources>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="TICKET" Width="120">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding TicketID}" FontFamily="Cascadia Code, Consolas"
                                                           Foreground="{StaticResource AccentCyanBright}" FontWeight="SemiBold"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="ASSET" Width="130">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding AssetName}" FontFamily="Cascadia Code, Consolas"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="STATUS" DisplayMemberBinding="{Binding Status}" Width="140"/>
                                    <GridViewColumn Header="REMAINING" DisplayMemberBinding="{Binding TimeRemaining}" Width="110"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- Toast Popup -->
        <Popup x:Name="ToastPopup" IsOpen="False" Placement="Center" AllowsTransparency="True" StaysOpen="False">
            <Border Background="{StaticResource BgSurface}" CornerRadius="16" Padding="22" Width="400"
                    BorderThickness="1" BorderBrush="{StaticResource AccentCyanDim}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" Color="Black" Opacity="0.5" ShadowDepth="6"/>
                </Border.Effect>
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource AccentCyanDim}" Width="32" Height="32" CornerRadius="8" HorizontalAlignment="Left">
                            <TextBlock Text="●" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource AccentCyanBright}"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="DEPLOYMENT NOTICE" FontWeight="Bold" Foreground="{StaticResource AccentCyanBright}"
                                   FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </Grid>

                    <TextBlock x:Name="ToastText" Text="PC deployment completed. Staging rules processed successfully."
                               Foreground="{StaticResource TextPrimary}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,20"/>

                    <Button Content="Run network preset automation" Click="RunAutomationClick" Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="20,4,20,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" FontSize="10" Foreground="{StaticResource TextFaint}" VerticalAlignment="Center">
                <Run Text="Built by "/>
                <Hyperlink NavigateUri="mailto:jasser.ben-abdallah@leoni.com"
                           RequestNavigate="Hyperlink_RequestNavigate"
                           Foreground="{StaticResource AccentCyan}">
                    <Run Text="Jasser Ben Abdallah"/>
                </Hyperlink>
                <Run Text=" · © 2026"/>
            </TextBlock>

            <Border Grid.Column="1" Background="{StaticResource BgSurfaceAlt}" CornerRadius="6" Padding="8,3">
                <TextBlock Text="v1.1.0" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold"/>
            </Border>
        </Grid>
    </Grid>
</Window>
