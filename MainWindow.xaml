<Window x:Class="OSDeploymentAssistant.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OS Asset Deployment Tool" 
        Width="580"
        SizeToContent="Height"
        MinHeight="600"
        MaxHeight="900"
        Background="#F4F7F6" 
        ResizeMode="CanMinimize" 
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Segoe UI Semibold, Arial">

    <Window.Resources>
        <!-- Modern ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Border x:Name="templateRoot" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <ContentPresenter x:Name="contentPresenter" 
                                                  Grid.Column="0"
                                                  Content="{TemplateBinding SelectionBoxItem}" 
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" 
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                                  Margin="{TemplateBinding Padding}" 
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" 
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" 
                                                  IsHitTestVisible="false"/>
                                
                                <!-- Arrow -->
                                <Grid Grid.Column="1" Width="20" Height="20" Margin="0,0,8,0">
                                    <Viewbox Width="10" Height="6"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center">
                                        <Path Fill="#94A3B8"
                                              Data="M 0,0 L 5,5 L 10,0 Z"/>
                                    </Viewbox>
                                </Grid>
                                
                                <ToggleButton x:Name="toggleButton" 
                                              Grid.ColumnSpan="2" 
                                              Background="Transparent" 
                                              BorderThickness="0" 
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Resources>
                                        <Style TargetType="ToggleButton">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ToggleButton.Resources>
                                </ToggleButton>
                                
                                <Popup x:Name="PART_Popup" 
                                       AllowsTransparency="true" 
                                       Grid.ColumnSpan="2" 
                                       IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" 
                                       PopupAnimation="{DynamicResource {x:Static SystemParameters.ComboBoxPopupAnimationKey}}" 
                                       Placement="Bottom">
                                    <Border x:Name="dropDownBorder" 
                                            Background="White"
                                            BorderBrush="#E2E8F0"
                                            BorderThickness="1" 
                                            CornerRadius="8" 
                                            MaxHeight="{TemplateBinding MaxDropDownHeight}" 
                                            MinWidth="{TemplateBinding ActualWidth}">
                                        <ScrollViewer x:Name="DropDownScrollViewer">
                                            <Grid x:Name="grid" RenderOptions.ClearTypeHint="Enabled">
                                                <Canvas x:Name="canvas" HorizontalAlignment="Left" Height="0" VerticalAlignment="Top" Width="0">
                                                    <Rectangle x:Name="opaqueRect" Fill="{Binding Background, ElementName=dropDownBorder}" Height="Auto" Width="Auto"/>
                                                </Canvas>
                                                <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Contained" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                            </Grid>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="templateRoot" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="templateRoot" Property="BorderBrush" Value="#2563EB"/>
                                <Setter TargetName="templateRoot" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="templateRoot" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBoxItem Style for dropdown items -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderThickness="0"
                                CornerRadius="4"
                                Margin="4,2">
                            <ContentPresenter HorizontalAlignment="Left" 
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E0F2FE"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#DBEAFE"/>
                                <Setter Property="Foreground" Value="#1E293B"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" 
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                          Focusable="false" 
                                          HorizontalScrollBarVisibility="Hidden" 
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#2563EB"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Form Label Style -->
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="6"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/> <!-- Added for footer -->
        </Grid.RowDefinitions>
        
        <Border Grid.Row="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#10B981" Offset="0.0"/>
                    <GradientStop Color="#2563EB" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="10,15,10,10">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="HeaderTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Margin="15,6" FontSize="13" FontWeight="SemiBold"/>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- TAB 1: CONFIGURATION FORM -->
            <TabItem Header="Deployment Config" Foreground="#1E293B">
                <Grid Margin="15,20,15,15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock Text="Asset Deployment Engine" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="Automated SCCM Staging &amp; ServiceNow Sync" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Select Infrastructure Node" Style="{StaticResource FormLabel}"/>
                            <ComboBox x:Name="ComboNode" SelectionChanged="OnNodeSelectionChanged">
                                <ComboBoxItem Content="LTN" IsSelected="True"/>
                                <ComboBoxItem Content="TN4"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Target Operating System" Style="{StaticResource FormLabel}"/>
                            <ComboBox x:Name="ComboOS" SelectionChanged="OnOSSelectionChanged">
                                <ComboBoxItem Content="Windows 10 Enterprise LTSC" IsSelected="True"/>
                                <ComboBoxItem Content="Windows 11 Enterprise LTSC (New HP G9)"/>
                                <ComboBoxItem Content="Windows 11 23H2 Enterprise"/>
                                <ComboBoxItem Content="Windows 11 24H2 Enterprise"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="PanelDeviceType" Grid.Column="0">
                            <TextBlock Text="Device Profile Template" Style="{StaticResource FormLabel}"/>
                            <ComboBox x:Name="ComboType" SelectionChanged="UpdateFormState"/>
                        </StackPanel>
                        <StackPanel x:Name="PanelSuffix" Grid.Column="2">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Optional Asset Suffix" Style="{StaticResource FormLabel}" Margin="0,0,0,0"/>
                                <TextBlock Text="(max 11 chars)" Foreground="#94A3B8" FontSize="10" FontWeight="Normal" VerticalAlignment="Bottom" Margin="8,0,0,2"/>
                            </StackPanel>
                            <TextBox x:Name="TxtSuffix" TextChanged="UpdateSuffixTextChanged" VerticalContentAlignment="Center"/>
                            <TextBlock x:Name="SuffixCharCounter" Text="0 / 11" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="3" Margin="0,0,0,16">
                        <StackPanel x:Name="PanelUser" Visibility="Collapsed" Margin="0,0,0,12">
                            <TextBlock Text="Assigned System Target User" Style="{StaticResource FormLabel}"/>
                            <TextBox x:Name="TxtUser" IsEnabled="False" Background="#F1F5F9" Foreground="#64748B" BorderBrush="#E2E8F0"/>
                        </StackPanel>
                        <StackPanel x:Name="PanelRollout" Visibility="Collapsed" Margin="0,0,0,12">
                            <TextBlock Text="Rollout Category Pipeline" Style="{StaticResource FormLabel}"/>
                            <ComboBox x:Name="ComboRollout">
                                <ComboBoxItem Content="Standard" IsSelected="True"/>
                                <ComboBoxItem Content="Pilot"/>
                                <ComboBoxItem Content="Critical"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel x:Name="PanelPatch" Visibility="Visible">
                            <TextBlock Text="Patching Cycle Schedule Allocation" Style="{StaticResource FormLabel}"/>
                            <ComboBox x:Name="ComboPatch">
                                <ComboBoxItem Content="Group A - Production Weekend" IsSelected="True"/>
                                <ComboBoxItem Content="Group B - Maintenance Window"/>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="4" Margin="0,0,0,20">
                        <TextBlock Text="Target Device Hardware Physical Addresses (Enter one MAC per line)" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="TxtMac" TextChanged="TxtMac_TextChanged"
                                 Height="80" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" 
                                 VerticalContentAlignment="Top" Padding="10,8"/>
                    </StackPanel>

                    <Border Grid.Row="5" CornerRadius="12" Padding="16,14" Margin="0,0,0,20" BorderThickness="1" BorderBrush="#E0E7FF">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#E0F2FE" Offset="0.0"/>
                                <GradientStop Color="#ECFDF5" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>
                            <TextBlock Text="CALCULATED TARGET ASSET NAME BASELINE" FontSize="11" FontWeight="Bold" Foreground="#0369A1"/>
                            <TextBox x:Name="TxtPreview" Text="MDLTN■■■" FontSize="20" FontWeight="Bold" Foreground="#0F172A" Background="Transparent" BorderThickness="0" IsReadOnly="True" Margin="0,4,0,0" Padding="0"/>
                        </StackPanel>
                    </Border>

                    <!-- Row 6: Execution Actions -->
                    <StackPanel Grid.Row="6" VerticalAlignment="Bottom">
                        <Button Content="🖥️ Create SCCM Asset &amp; Sync ServiceNow" 
                                Click="CreateServiceNowTicketClick" 
                                Height="46" 
                                Foreground="White" 
                                FontWeight="Bold" 
                                FontSize="14" 
                                Cursor="Hand"
                                ToolTip="Creates a new asset in SCCM and generates a ServiceNow RITM ticket">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" CornerRadius="10" Background="#0369A1">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#0284C7"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#075985"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- TAB 2: AUTOMATION -->
            <TabItem Header="Automation" Foreground="#1E293B">
                <Grid Margin="15,20,15,15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock Text="Post-Installation Automation Engine" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="Apply system configurations locally or remotely via SCCM/AD" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Execution Target Selection -->
                    <Border Grid.Row="1" CornerRadius="12" Padding="16,14" Margin="0,0,0,16" BorderThickness="1" BorderBrush="#E2E8F0" Background="White">
                        <StackPanel>
                            <TextBlock Text="🎯 Execution Target" FontWeight="Bold" FontSize="14" Foreground="#1E293B" Margin="0,0,0,12"/>
                            
                            <RadioButton x:Name="RdoLocal" Content="Local Machine (Run on this PC)" GroupName="ExecutionTarget" 
                                         IsChecked="True" Foreground="#374151" Margin="0,0,0,8" Cursor="Hand" Checked="RdoLocal_Checked"/>
                            
                            <RadioButton x:Name="RdoRemote" Content="Remote PC via SCCM/AD" GroupName="ExecutionTarget" 
                                         Foreground="#374151" Margin="0,0,0,8" Cursor="Hand" Checked="RdoRemote_Checked"/>
                            
                            <StackPanel x:Name="PanelRemote" IsEnabled="False" Margin="0,8,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Target Computer Name:" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                                        <TextBox x:Name="TxtRemotePC" Text=""
                                                 Background="#F8FAFC" Foreground="#1E293B" IsEnabled="False"
                                                 KeyDown="TxtRemotePC_KeyDown" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                    
                                    <Button x:Name="BtnPing" Grid.Column="1" Content="🔍 Ping" 
                                            Width="80" Height="35" Margin="10,20,0,0"
                                            Background="#10B981" Foreground="White" FontWeight="Bold"
                                            Cursor="Hand" IsEnabled="False"
                                            Click="BtnPing_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border CornerRadius="8" Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                                
                                <!-- Ping Status Indicator -->
                                <Border x:Name="PingStatus" CornerRadius="6" Padding="10,6" Margin="0,6,0,0" 
                                        Background="#F1F5F9" BorderThickness="1" BorderBrush="#E2E8F0">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="PingIndicator" Width="10" Height="10" Fill="#94A3B8" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="PingStatusText" Text="Not tested" FontSize="11" Foreground="#64748B"/>
                                    </StackPanel>
                                </Border>
                                
                                <TextBlock FontSize="10" Foreground="#94A3B8" Margin="0,4,0,0">
                                    Enter the computer name as registered in AD/SCCM, then click Ping to test connectivity
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Automation Options -->
                    <Border Grid.Row="2" CornerRadius="12" Padding="16,14" Margin="0,0,0,16" BorderThickness="1" BorderBrush="#E2E8F0" Background="White">
                        <StackPanel>
                            <TextBlock Text="⚙️ Automation Options" FontWeight="Bold" FontSize="14" Foreground="#1E293B" Margin="0,0,0,12"/>
                            
                            <CheckBox x:Name="ChkFirewall" Content="Open ICMPv4 (Allow Ping)" IsChecked="True" Foreground="#374151" Margin="0,0,0,8" Cursor="Hand"/>
                            <CheckBox x:Name="ChkTimezone" Content="Set Timezone: W. Central Africa Standard Time" IsChecked="True" Foreground="#374151" Margin="0,0,0,8" Cursor="Hand"/>
                            <CheckBox x:Name="ChkKeyboard" Content="Set Keyboard Layout: French (fr-FR)" IsChecked="True" Foreground="#374151" Margin="0,0,0,8" Cursor="Hand"/>
                            <CheckBox x:Name="ChkRegistryFix" Content="Apply Windows Update Registry Fix" IsChecked="False" Foreground="#374151" Margin="0,0,0,8" Cursor="Hand"/>
                            
                            <Separator Margin="0,8,0,8"/>
                            
                            <CheckBox x:Name="ChkSCCM" Content="Trigger SCCM Client Policy Retrieval &amp; Evaluation" IsChecked="False" Foreground="#374151" Margin="0,0,0,8" Cursor="Hand"/>
                            <CheckBox x:Name="ChkAD" Content="Update AD Computer Object Description/Info" IsChecked="False" Foreground="#374151" Cursor="Hand"/>
                        </StackPanel>
                    </Border>

                    <!-- Execute Button -->
                    <StackPanel Grid.Row="3" VerticalAlignment="Bottom" Margin="0,0,0,10">
                        <Button x:Name="BtnExecute" Content="⚡ Execute Post-Installation Automation" 
                                Click="RunAutomationClick" Height="46" Foreground="White" FontWeight="Bold" FontSize="14" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" CornerRadius="10" Background="#2563EB">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="border" Property="Background" Value="#94A3B8"/>
                                            <Setter Property="Foreground" Value="#CBD5E1"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#1D4ED8"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#1E3A8A"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <!-- Status Area -->
                    <Border Grid.Row="4" CornerRadius="8" Padding="12" Margin="0,10,0,0" BorderThickness="1" BorderBrush="#E2E8F0" Background="#F8FAFC">
                        <TextBox x:Name="TxtAutomationStatus" Text="Ready. Select target and options, then click Execute to begin." 
                                 FontSize="12" Foreground="#64748B" Background="Transparent" 
                                 BorderThickness="0" IsReadOnly="True" TextWrapping="Wrap"/>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 3: LIVE TRACKING MONITOR -->
            <TabItem Header="Active Live Tickets" Foreground="#1E293B">
                <Grid Margin="15,20,15,15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Margin="0,0,0,15">
                        <TextBlock Text="Active Pipeline Management Board" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="Automatic lifecycle deletion triggers exactly 45 minutes from ticket birth" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>
                    
                    <Border Grid.Row="1" CornerRadius="12" BorderThickness="1" BorderBrush="#E2E8F0" Background="White" ClipToBounds="True">
                        <ListView x:Name="ListTickets" BorderThickness="0" Background="Transparent" AlternationCount="2">
                            <ListView.Resources>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0,12"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="#F1F5F9"/>
                                </Style>
                            </ListView.Resources>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Ticket ID" DisplayMemberBinding="{Binding TicketID}" Width="110"/>
                                    <GridViewColumn Header="Target Name" DisplayMemberBinding="{Binding AssetName}" Width="120"/>
                                    <GridViewColumn Header="Status Flag" DisplayMemberBinding="{Binding Status}" Width="130"/>
                                    <GridViewColumn Header="Timer Ticker" DisplayMemberBinding="{Binding TimeRemaining}" Width="120"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Toast Popup -->
        <Popup x:Name="ToastPopup" IsOpen="False" Placement="Center" AllowsTransparency="True" StaysOpen="False">
            <Border Background="#F8FAFC" CornerRadius="16" Padding="24" Width="400" BorderThickness="1" BorderBrush="#10B981">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" Color="#0F172A" Opacity="0.15" ShadowDepth="4"/>
                </Border.Effect>
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="#D1FAE5" Width="32" Height="32" CornerRadius="8" HorizontalAlignment="Left">
                            <TextBlock Text="🔔" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="DEPLOYMENT SYSTEM NOTICE" FontWeight="Bold" Foreground="#065F46" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </Grid>
                    
                    <TextBlock x:Name="ToastText" Text="PC Deployment completed. Staging rules processed successfully." Foreground="#334155" FontSize="13.5" TextWrapping="Wrap" Margin="0,4,0,20"/>
                    
                    <Button Content="⚡ Invoke Pipeline Network IPv4 Presets" Click="RunAutomationClick" Height="40" Foreground="White" FontWeight="Bold" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="8" Background="#2563EB">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
